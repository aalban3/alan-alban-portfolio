        <mxCell id="sub" value="Public overview generated from the portfolio case study. Detailed diagrams live in Dashdoc.Infra." style="text;html=1;fontSize=12;fontColor=#666666;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="800" height="20" as="geometry"/></mxCell>
        <mxCell id="g-cloud" value="Aws cloud · prod" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;container=0;verticalAlign=top;align=left;spacingLeft=30;dashed=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_aws_cloud_alt;strokeColor=#232F3E;fillColor=none;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="240" width="1014" height="663" as="geometry"/></mxCell>
        <mxCell id="g-vpc" value="Vpc" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;container=0;verticalAlign=top;align=left;spacingLeft=30;dashed=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_vpc2;strokeColor=#8C4FFF;fillColor=none;fontColor=#8C4FFF;" vertex="1" parent="1"><mxGeometry x="52" y="285" width="744" height="606" as="geometry"/></mxCell>
        <mxCell id="g-public" value="Public subnet" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;container=0;verticalAlign=top;align=left;spacingLeft=30;dashed=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_public_subnet;strokeColor=#7AA116;fillColor=#F2F6E8;fontColor=#248814;" vertex="1" parent="1"><mxGeometry x="64" y="315" width="720" height="120" as="geometry"/></mxCell>
        <mxCell id="g-compute" value="Ecs fargate · private subnet" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;container=0;verticalAlign=top;align=left;spacingLeft=30;dashed=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_private_subnet;strokeColor=#00A4A6;fillColor=#E6F6F7;fontColor=#147EBA;" vertex="1" parent="1"><mxGeometry x="64" y="459" width="720" height="141" as="geometry"/></mxCell>
        <mxCell id="g-data" value="Data · private subnet" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;container=0;verticalAlign=top;align=left;spacingLeft=30;dashed=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_private_subnet;strokeColor=#00A4A6;fillColor=#E6F6F7;fontColor=#147EBA;" vertex="1" parent="1"><mxGeometry x="64" y="624" width="720" height="255" as="geometry"/></mxCell>
        <mxCell id="g-label" value="Managed services" style="text;html=1;fontSize=12;fontStyle=1;fontColor=#01A88D;align=left;" vertex="1" parent="1"><mxGeometry x="820" y="294" width="200" height="20" as="geometry"/></mxCell>
        <mxCell id="user" value="&lt;b&gt;Clinician&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;Browser&lt;/font&gt;" tooltip="SLPs and practice staff using the Dashdoc web app." style="sketch=0;outlineConnect=0;html=1;whiteSpace=wrap;fontSize=12;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=6;shape=mxgraph.aws4.user;fillColor=#5F6368;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="324" y="139.5" width="48" height="48" as="geometry"/></mxCell>
        <mxCell id="grafana" value="&lt;b&gt;Grafana Cloud&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;OpenTelemetry&lt;/font&gt;" tooltip="Receives traces from the Core API, so slow requests and errors show up end to end." style="sketch=0;outlineConnect=0;html=1;whiteSpace=wrap;fontSize=12;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=6;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch_2;fillColor=#F46800;strokeColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="828" y="139.5" width="48" height="48" as="geometry"/></mxCell>
        <mxCell id="alb" value="&lt;b&gt;Load Balancer&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;Application LB&lt;/font&gt;" tooltip="HTTPS entry point. Terminates TLS and routes traffic to the services in the private subnet." style="sketch=0;outlineConnect=0;html=1;whiteSpace=wrap;fontSize=12;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=6;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.elastic_load_balancing;fillColor=#8C4FFF;strokeColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="324" y="351.5" width="48" height="48" as="geometry"/></mxCell>
        <mxCell id="cognito" value="&lt;b&gt;Cognito&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;Amazon Cognito&lt;/font&gt;" tooltip="User pool for sign-in and MFA. Issues the JWTs that every service validates." style="sketch=0;outlineConnect=0;html=1;whiteSpace=wrap;fontSize=12;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=6;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cognito;fillColor=#DD344C;strokeColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="828" y="351.5" width="48" height="48" as="geometry"/></mxCell>
        <mxCell id="api" value="&lt;b&gt;Core API&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;.NET · Fargate&lt;/font&gt;" tooltip="Core API: practices, users, roles and clients. A stateless resource server." style="sketch=0;outlineConnect=0;html=1;whiteSpace=wrap;fontSize=12;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=6;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.fargate;fillColor=#ED7100;strokeColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="78" y="513.5" width="48" height="48" as="geometry"/></mxCell>
        <mxCell id="bff" value="&lt;b&gt;Web Gateway (BFF)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;.NET · Fargate&lt;/font&gt;" tooltip="Serves the React app and acts as its backend-for-frontend. Owns sign-in and the session cookie, then calls the services on the user's behalf." style="sketch=0;outlineConnect=0;html=1;whiteSpace=wrap;fontSize=12;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=6;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.fargate;fillColor=#ED7100;strokeColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="324" y="513.5" width="48" height="48" as="geometry"/></mxCell>
        <mxCell id="docs" value="&lt;b&gt;Document Engine&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;.NET · Fargate&lt;/font&gt;" tooltip="Evaluations, SOAP notes and plans, plus PDF generation." style="sketch=0;outlineConnect=0;html=1;whiteSpace=wrap;fontSize=12;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=6;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.fargate;fillColor=#ED7100;strokeColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="570" y="513.5" width="48" height="48" as="geometry"/></mxCell>
        <mxCell id="bedrock" value="&lt;b&gt;Bedrock&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;Titan Embeddings&lt;/font&gt;" tooltip="Embeds document content. Model calls stay inside the AWS account." style="sketch=0;outlineConnect=0;html=1;whiteSpace=wrap;fontSize=12;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=6;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock;fillColor=#01A88D;strokeColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="828" y="513.5" width="48" height="48" as="geometry"/></mxCell>
        <mxCell id="apidb" value="&lt;b&gt;Core DB&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;RDS PostgreSQL&lt;/font&gt;" tooltip="The Core API's own database. Multi-AZ, encrypted at rest." style="sketch=0;outlineConnect=0;html=1;whiteSpace=wrap;fontSize=12;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=6;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.rds;fillColor=#C925D1;strokeColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="78" y="694.5" width="48" height="48" as="geometry"/></mxCell>
